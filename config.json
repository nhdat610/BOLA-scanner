{
    "target_url": "http://localhost:8888/", 

    "scope": {
        "allowed_domains": [
            "localhost"
        ]
    },

    "allowed_hosts": [
        "localhost"
    ],

    "crawl": {
        "max_pages": 30,
        "max_depth": 2,
        "timeout_ms": 10000,
        "network_wait_timeout_ms": 2000,
        "network_quiet_ms": 1000,
        "network_quiet_timeout_ms": 10000
    },

    "auth": {
        "accounts": {
            "test_user_a": {
                "custom_headers": {}
            },
            "test_user_b": {
                "custom_headers": {}
            }
        },
        "defaults": {
            "cookie": "auto",
            "capture_authorization": true,
            "bearer_token_env": null,
            "custom_headers": {}
        }
    },

    "openapi": {
        "url": null,
        "file": null
    },
    
    "execution": {
        "enabled": true,
        "allow_mutation": false,
        "allowed_methods": [
            "GET",
            "HEAD",
            "OPTIONS"
        ],
        "max_requests": 50,
        "delay_ms": 500,
        "timeout_ms": 10000,
        "max_response_body": 100000
    }
}
